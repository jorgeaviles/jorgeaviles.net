{
  "name": "jorge-aviles-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:publication": "node scripts/test-publication.mjs",
    "assets:social": "node scripts/generate-social.mjs",
    "build": "astro build && node scripts/sync-portfolio-index.mjs --check && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test:browser": "playwright test && npm run test:assistant",
    "verify": "npm run check && npm run lint && npm run format:check && npm test && npm run test:publication && npm run build && npm run test:browser",
    "deploy": "node scripts/deploy.mjs",
    "assistant:index": "astro build && node scripts/sync-portfolio-index.mjs",
    "test:assistant": "playwright test --config playwright.assistant.config.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/react": "7.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
