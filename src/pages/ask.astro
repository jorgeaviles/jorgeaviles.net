---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import PortfolioAssistant from '../components/PortfolioAssistant';
import { configuredEndpoint, PUBLIC_API } from '../lib/portfolio/client';
const endpoint = configuredEndpoint(
  import.meta.env.PUBLIC_PORTFOLIO_API_URL ?? PUBLIC_API,
);
---

<BaseLayout
  title="Ask about my work"
  description="Find source-backed passages about my public projects, professional background, and research assistance."
>
  <PageIntro
    label="Portfolio assistant"
    title="A question about the work?"
    description="Find a starting point in the published projects, professional background, and research."
  />
  <div class="editorial-grid">
    <div>
      <PortfolioAssistant endpoint={endpoint} client:load />
      <noscript>
        <p>
          This assistant needs JavaScript. The public source pages remain
          available below.
        </p>
      </noscript>
      <nav class="assistant-sources" aria-label="Portfolio source pages">
        <h2>Explore directly</h2>
        <a href="/work/">Selected work</a>
        <a href="/about/">About & experience</a>
        <a href="/research/">Research assistance</a>
      </nav>
    </div>
    <aside class="aside-note">
      <p class="eyebrow">Public sources only</p>
      <p>
        A small AI-assisted guide to this portfolio. It selects passages from an
        approved public index and links to the original pages.
      </p>
      <p>
        It cannot search agency records, private documents, or the wider web.
        Each question stands alone.
      </p>
      <p>
        For external AI applications, see the{' '}
        <a href="/mcp/">public MCP integration</a>.
      </p>
    </aside>
  </div>
</BaseLayout>

<style is:global>
  .portfolio-assistant {
    max-width: var(--measure-reading);
  }
  .portfolio-assistant label {
    display: block;
    font-weight: 600;
  }
  .portfolio-assistant #question-help,
  .assistant-privacy,
  .assistant-count,
  .assistant-caption {
    font-size: var(--text-supporting);
    color: var(--muted);
  }
  .portfolio-assistant #question-help {
    margin-block: 8px 16px;
  }
  .portfolio-assistant textarea {
    display: block;
    width: 100%;
    resize: vertical;
    min-height: 132px;
    background: transparent;
    border: 1px solid var(--muted);
    border-radius: 2px;
    color: var(--ink);
    font: inherit;
    padding: 12px;
  }
  .assistant-count {
    text-align: right;
    margin-block: 4px 16px;
  }
  .assistant-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .assistant-actions button {
    min-height: 44px;
    padding: 10px 18px;
    border: 1px solid var(--green);
    border-radius: 2px;
    background: var(--green);
    color: var(--paper);
    cursor: pointer;
  }
  .assistant-actions .assistant-clear {
    background: transparent;
    color: var(--ink);
    border-color: transparent;
    text-decoration: underline;
  }
  .portfolio-assistant button:disabled {
    cursor: default;
    opacity: 0.65;
  }
  .assistant-privacy {
    margin-top: 16px;
  }
  .assistant-privacy a,
  .assistant-result a,
  .assistant-sources a {
    text-decoration: underline;
  }
  .assistant-suggestions {
    margin-top: 32px;
  }
  .assistant-suggestions ul,
  .assistant-result ul {
    padding: 0;
    list-style: none;
    margin-block: 8px 0;
  }
  .assistant-suggestions button {
    text-align: left;
    min-height: 44px;
    padding: 8px 0;
    background: transparent;
    border: 0;
    color: var(--green);
    text-decoration: underline;
    cursor: pointer;
  }
  .assistant-notice,
  .assistant-status {
    color: var(--green);
  }
  .assistant-notice {
    margin-bottom: 24px;
  }
  .assistant-status:not(:empty) {
    margin-top: 32px;
  }
  .assistant-result {
    margin-top: 32px;
  }
  .assistant-result h2,
  .assistant-sources h2 {
    font-size: var(--text-article-heading);
    margin-bottom: 20px;
  }
  .assistant-result p {
    margin-block: 0 20px;
    overflow-wrap: anywhere;
  }
  .assistant-result h3 {
    font-family: var(--font-sans);
    font-size: var(--text-supporting);
    font-weight: 600;
    margin-block: 24px 8px;
  }
  .assistant-result li a,
  .assistant-sources > a {
    display: inline-block;
    min-height: 44px;
    padding-block: 8px;
  }
  .assistant-result .assistant-caption {
    margin-top: 16px;
  }
  .assistant-sources {
    margin-top: 48px;
  }
  .assistant-sources > a {
    margin-right: 24px;
  }
  @media (max-width: 600px) {
    .assistant-actions {
      align-items: stretch;
    }
    .assistant-actions button {
      max-width: 100%;
    }
  }
</style>
