---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Arrow from '../components/Arrow.astro';
import Background from '../content/background.mdx';
import EducationSection from '../components/EducationSection.astro';
---

<BaseLayout
  title="About"
  description="My background connects business analysis, data engineering, applied research, and application development."
>
  <PageIntro label="About" title="Experience, education & approach." />
  <nav class="career-navigation" aria-label="Experience and education">
    <a href="#cpcs-experience">CPCS</a>
    <a href="#santander-experience">Santander</a>
    <a href="#centrum-experience">CENTRUM</a>
    <a href="#education">Education</a>
  </nav>
  <div class="reading-column">
    <div class="prose major-sections">
      <Background />
      <a class="text-link" href="/work/">
        Explore selected work <Arrow />
      </a>
    </div>
  </div>
  <EducationSection />
</BaseLayout>

<style>
  .career-navigation {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-bottom: 32px;
  }
  .career-navigation a {
    padding-block: 10px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .major-sections :global(.experience-entry) {
    display: flow-root;
  }
  .major-sections :global(.experience-entry + .experience-entry) {
    margin-top: var(--space-8);
  }
  .major-sections :global(.experience-entry h3) {
    margin-block: 0 var(--space-4);
  }
  .major-sections :global(.experience-entry > :last-child) {
    margin-bottom: 0;
  }
  .major-sections :global(.experience-roles) {
    list-style: none;
    padding: 0;
    margin-block: 0 var(--space-4);
  }
  .major-sections :global(.experience-roles li + li) {
    margin-top: var(--space-4);
  }
  .major-sections :global(.experience-roles p) {
    margin-top: var(--space-2);
  }
  .major-sections :global(.experience-links) {
    margin-block: var(--space-6);
  }
  .major-sections :global(.experience-links ul) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .major-sections :global(.experience-links li + li) {
    margin-top: 0;
  }
</style>
