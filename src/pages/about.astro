---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Arrow from '../components/Arrow.astro';
import BrandIcon from '../components/BrandIcon.astro';
import Background from '../content/background.mdx';
import { site } from '../config/site';
---

<BaseLayout
  title="About"
  description="My background connects business analysis, data engineering, applied research, and application development."
>
  <PageIntro
    label="About"
    title="Experience, education & approach."
    description="From banking and university research to developing analytical data infrastructure and applications in legal services."
  />
  <div class="editorial-grid">
    <div class="prose">
      <Background />
      <a class="text-link" href="/work/">
        Explore selected work <Arrow />
      </a>
    </div>
    <aside class="aside-note" id="education">
      <p class="eyebrow">Education</p>
      <h3>BA in Economics</h3>
      <p>
        Suffolk University
        <br />
        2011
      </p>
      <div class="aside-divider"></div>
      <p class="eyebrow">Elsewhere</p>
      <a href={site.github}>
        <BrandIcon brand="github" /> GitHub <Arrow diagonal />
      </a>
      <a href={site.linkedin}>
        <BrandIcon brand="linkedin" /> LinkedIn <Arrow diagonal />
      </a>
    </aside>
  </div>
  <section class="section-space capabilities">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Capabilities</p>
        <h2>Different tools. A shared purpose.</h2>
      </div>
    </div>
    <div class="capability-grid">
      <div>
        <span class="work-number">01</span>
        <h3>Business analysis</h3>
        <p>
          Stakeholder consultation, requirements, prioritization, and
          translating operational needs into useful systems.
        </p>
      </div>
      <div>
        <span class="work-number">02</span>
        <h3>Data & analytics</h3>
        <p>
          SQL, Python, R, Jupyter, data engineering, reporting, and statistical
          and machine-learning methods.
        </p>
      </div>
      <div>
        <span class="work-number">03</span>
        <h3>Applications & technology</h3>
        <p>
          C#, .NET, Blazor, Azure data services, and practical exploration of
          AI-assisted information access.
        </p>
      </div>
    </div>
    <p class="section-footnote">
      Background based on my{' '}
      <a href={site.profileSource}>public professional profile</a>.
    </p>
  </section>
</BaseLayout>
