---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkList from '../components/WorkList.astro';
import Arrow from '../components/Arrow.astro';
import { getPublishedEntries } from '../lib/content';
const work = (await getPublishedEntries('work')).filter(
  (entry) => entry.data.featured && entry.data.workType === 'project',
);
---

<BaseLayout>
  <section class="home-intro">
    <div class="hero-main">
      <p class="eyebrow">
        <span class="small-rule" aria-hidden="true"></span>Jorge Aviles ·
        Analyst & developer
      </p>
      <h1>
        Building <em>data platforms</em> and applications for analytical work.
      </h1>
      <p class="hero-description">
        I’m a Senior Auditor Data Analyst at the Committee for Public Counsel
        Services. I develop analytical notebooks, an Azure data platform,
        experimental machine-learning pipelines, and a Blazor application that
        connect investigation with day-to-day audit work.
      </p>
      <div class="hero-links">
        <a class="button" href="/work/">
          View technical case studies <Arrow />
        </a>
        <a class="text-link" href="/about/">
          Experience & education <Arrow />
        </a>
      </div>
    </div>
    <aside class="hero-note">
      <p class="eyebrow">Technical focus</p>
      <p>Python &amp; PySpark preparation</p>
      <p>Synapse serverless SQL &amp; ADLS Gen2</p>
      <p>C# &amp; Blazor applications</p>
      <p>Supervised learning &amp; model evaluation</p>
      <p class="hero-note-context">
        Requirements and design shaped with the people using the work.
      </p>
    </aside>
  </section>
  <div class="context-strip">
    <p>
      Experience across <strong>legal services, banking, and academia.</strong>
    </p>
    <a href="/about/">
      View professional background <Arrow />
    </a>
  </div>
  <section class="home-work section-space" aria-labelledby="selected-work">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="selected-work">Applications, data & machine learning.</h2>
      </div>
      <a class="text-link" href="/work/">
        View all work <Arrow />
      </a>
    </div>
    <WorkList entries={work} />
    <p class="section-footnote">
      Application development, analytical infrastructure, and experimental
      modeling for human review.
    </p>
  </section>
  <section class="explore-section" aria-labelledby="explore-title">
    <div class="explore-copy">
      <p class="eyebrow">A closer look</p>
      <h2 id="explore-title">
        Research background.
        <br />
        Hands-on learning.
      </h2>
      <p>
        Research informs how I ask questions. Small experiments help me make the
        answers tangible.
      </p>
    </div>
    <div class="explore-links">
      <a href="/research/">
        <span class="work-category">Research & writing</span>
        <h3>Academic research assistance</h3>
        <p>
          Research assistance, quantitative questions, and the care behind a
          useful conclusion.
        </p>
        <Arrow />
      </a>
      <a href="/lab/">
        <span class="work-category">The lab</span>
        <h3>Explore the machine-learning lab</h3>
        <p>
          Train regression and classification models, then explore decisions
          with a clearly synthetic dataset.
        </p>
        <Arrow />
      </a>
    </div>
  </section>
  <section class="contact-band">
    <div>
      <p class="eyebrow">Let’s connect</p>
      <h2>Have a question worth exploring?</h2>
      <p>
        I welcome conversations about analysis, research, and practical
        technology.
      </p>
    </div>
    <a class="text-link" href="/contact/">
      Contact me <Arrow />
    </a>
  </section>
</BaseLayout>
