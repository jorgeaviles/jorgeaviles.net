---
import HomeExperience from '../content/home-experience.mdx';
import EducationSection from '../components/EducationSection.astro';
import BrandIcon from '../components/BrandIcon.astro';
import HomeResearch from '../content/home-research.mdx';
import HomeIntroduction from '../content/home-introduction.mdx';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkList from '../components/WorkList.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../config/site';
import { getPublishedEntries } from '../lib/content';
const work = (await getPublishedEntries('work')).filter(
  (entry) => entry.data.featured && entry.data.workType === 'project',
);
const research = await getPublishedEntries('research');
---

<BaseLayout>
  <section class="home-intro">
    <div class="hero-main">
      <p class="eyebrow">
        <span class="small-rule" aria-hidden="true"></span>
        {site.name} · Analyst & developer
      </p>
      <h1>
        Building <em>data platforms</em> and applications for analytical work.
      </h1>
      <div class="hero-description">
        <HomeIntroduction />
      </div>
      <div class="hero-links">
        <a class="button" href="#projects">
          View technical case studies <Arrow />
        </a>
        <a class="text-link" href="#experience">
          Experience & education <Arrow />
        </a>
      </div>
    </div>
  </section>
  <section
    id="projects"
    class="home-work portfolio-section"
    aria-labelledby="selected-work"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="selected-work">Applications, data & machine learning.</h2>
      </div>
    </div>
    <WorkList entries={work} expanded />
  </section>
  <section
    id="experience"
    class="portfolio-section"
    aria-labelledby="experience-title"
  >
    <h2 id="experience-title">Experience</h2>
    <HomeExperience />
  </section>
  <EducationSection />
  <section
    id="research"
    class="portfolio-section home-research"
    aria-labelledby="research-title"
  >
    <h2 id="research-title">Research &amp; inquiry</h2>
    {research.map((entry) => (
      <article class="research-entry">
        <div class="research-meta">
          <span class="mono-label">Acknowledged research assistance</span>
        </div>
        <div>
          <h3>{entry.data.title}</h3>
          <div class="prose">
            <HomeResearch />
          </div>
          <div class="source-links">
            {entry.data.sources.map((source) => (
              <a class="text-link" href={source.url}>
                {source.label} <Arrow diagonal />
              </a>
            ))}
          </div>
        </div>
      </article>
    ))}
    <p class="section-footnote">
      For a separate hands-on example with independently fabricated data,{' '}
      <a href="/lab/">explore the machine-learning Lab</a>.
    </p>
  </section>
  <section
    id="contact"
    class="portfolio-section home-contact"
    aria-labelledby="contact-title"
  >
    <h2 id="contact-title">Let’s connect.</h2>
    <p>
      I welcome conversations about analysis, research, and practical
      technology.
    </p>
    <p class="contact-address">
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <div class="home-contact-links">
      <a class="text-link" href={site.github}>
        <BrandIcon brand="github" /> GitHub <Arrow diagonal />
      </a>
      <a class="text-link" href={site.linkedin}>
        <BrandIcon brand="linkedin" /> LinkedIn <Arrow diagonal />
      </a>
    </div>
  </section>
</BaseLayout>
