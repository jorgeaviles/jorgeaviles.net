---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import LearningLab from '../components/LearningLab';
import { getPublishedEntries } from '../lib/content';
const entries = await getPublishedEntries('lab');
---

<BaseLayout
  title="Lab"
  description="Train small linear and logistic regression models locally, then explore validation decisions using synthetic data."
>
  <PageIntro
    label="The lab"
    title="A question you can interact with."
    description="Small, explainable experiments at the intersection of analysis and engineering."
  />
  {entries.length > 0 && <LearningLab client:visible />}
  <noscript>
    <p>
      JavaScript is disabled. Linear regression fits a line by reducing mean
      squared error. Logistic regression transforms a weighted feature score
      with sigmoid and learns using log loss. Evaluation compares
      model-generated predictions with labels on held-out records. Enable
      JavaScript to train these synthetic models locally; no real records or
      operational performance are represented.
    </p>
  </noscript>
</BaseLayout>
