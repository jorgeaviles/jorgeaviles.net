---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LearningLab from '../components/LearningLab';
import { getPublishedEntries } from '../lib/content';
const entries = await getPublishedEntries('lab');
const entry = entries[0];
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

<BaseLayout title="Lab" description={entry?.data.description}>
  <header class="lab-page-intro">
    <p class="eyebrow">The lab</p>
    <h1>{entry?.data.title}</h1>
    <p>{entry?.data.description}</p>
  </header>
  {entry && <LearningLab client:load />}
  <noscript>
    <div class="prose">{Content && <Content />}</div>
  </noscript>
</BaseLayout>
