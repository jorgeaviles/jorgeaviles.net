---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Mcp from '../content/mcp.mdx';
---

<BaseLayout
  title="Portfolio MCP integration"
  description="Explore published projects, professional experience, and research through source-linked, read-only tools for compatible AI applications."
>
  <PageIntro label="Portfolio integration" title="Connect to the work." />
  <div class="editorial-grid">
    <article class="prose mcp-documentation">
      <Mcp />
    </article>
    <aside class="aside-note">
      <p class="eyebrow">At a glance</p>
      <p>Read-only · Public sources · Original page links</p>
      <a href="#connect-an-ai-application">Connection instructions</a>
      <a href="/ask/">Use the website assistant</a>
      <a href="/work/">Read the case studies</a>
    </aside>
  </div>
</BaseLayout>

<style>
  .mcp-documentation {
    min-width: 0;
  }
  .mcp-documentation :global(code) {
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }
  .mcp-documentation :global(pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding: 16px;
    line-height: 1.7;
    margin-block: 20px;
  }
  .mcp-documentation :global(.mcp-endpoint) {
    display: block;
    color: var(--ink);
    margin-block: 20px;
    user-select: all;
  }
  .mcp-documentation :global(.mcp-flow) {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    color: var(--green);
    font-size: var(--text-supporting);
    line-height: 1.6;
    margin-block: 28px;
  }
  .mcp-documentation :global(.mcp-flow li + li) {
    margin: 0;
  }
  .mcp-documentation :global(.mcp-flow li:not(:last-child)::after) {
    content: ' →';
    margin-left: 14px;
  }
</style>
