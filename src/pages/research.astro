---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Arrow from '../components/Arrow.astro';
import ResearchBackground from '../content/research-background.mdx';
import ResearchDevelopment from '../content/research-development.mdx';
import { getPublishedEntries } from '../lib/content';
const entries = await Promise.all(
  (await getPublishedEntries('research')).map(async (entry) => ({
    entry,
    ...(await render(entry)),
  })),
);
---

<BaseLayout
  title="Research"
  description="Faculty research experience and acknowledged research assistance in a 2014 study, connecting economics, business questions, and quantitative methods."
>
  <PageIntro
    label="Research & writing"
    title="Research assistance & quantitative inquiry."
    description="Economic and business questions, quantitative methods, and the development of my analytical practice."
  />
  <div class="research-context prose">
    <ResearchBackground />
  </div>
  {entries.map(({ entry, Content }) => (
    <article class="research-entry">
      <div class="research-meta">
        <p class="eyebrow">{entry.data.category}</p>
        <span class="mono-label">Acknowledged research assistance</span>
      </div>
      <div>
        <h2>{entry.data.title}</h2>
        <div class="prose">
          <Content />
        </div>
        <div class="source-links">
          {entry.data.sources.map((source) => (
            <a class="text-link" href={source.url}>
              {source.label} <Arrow diagonal />
            </a>
          ))}
        </div>
      </div>
    </article>
  ))}
  <section class="research-context prose">
    <ResearchDevelopment />
  </section>
</BaseLayout>
