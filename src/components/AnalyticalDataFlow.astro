        </table>
      </div>
    </li>
    <li>
      <div class="flow-stage">
        <span class="stage-number" aria-hidden="true">
          02
        </span>
        <h3>Prepare</h3>
        <span class="flow-arrow" aria-hidden="true">
          ↓
        </span>
      </div>
      <div class="flow-content">
        <p class="stage-intro">
