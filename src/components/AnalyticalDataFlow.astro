---
const stages = [
  [
    'Source',
    'Legacy extracts → ADLS Gen2',
    'Scheduled source snapshots provide the input. Delivery and extract context determine the starting freshness.',
  ],
  [
    'Prepare',
    'Python / PySpark → Parquet',
    'Transform types, align repeated groups, and check counts and grain. Separate malformed input for review.',
  ],
  [
    'Serve',
    'Validated files → Synapse serverless SQL',
    'Selected workflows stage and publish serving data. External tables, views, and selected procedures provide SQL access.',
  ],
  [
    'Apply',
    'Investigation, reporting & application queries',
    'Consumers reuse prepared information. Exploratory notebooks remain distinct from published data contracts.',
  ],
];
---

<figure
  class="analytical-flow architecture-flow"
  aria-label="Conceptual analytical data flow"
>
  <ol>
    {stages.map(([title, technology, description], index) => (
      <li>
        <span class="flow-number" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <div>
          <h3>{title}</h3>
          <p class="flow-technology">{technology}</p>
          <p>{description}</p>
        </div>
      </li>
    ))}
  </ol>
  <figcaption>
    Conceptual architecture using technology categories and responsibilities.
    Not a diagram of the internal production environment.
  </figcaption>
</figure>
