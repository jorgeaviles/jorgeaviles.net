---
import Education from '../content/education.mdx';
---

<section
  class="education-section section-space"
  id="education"
  aria-labelledby="education-heading"
>
  <Education />
</section>
<style>
  .education-section {
    border-top: 1px solid var(--line);
    padding-top: 36px;
  }
  .education-section :global(h2) {
    max-width: 800px;
    margin-bottom: 20px;
  }
  .education-section :global(.education-intro) {
    max-width: 690px;
    color: var(--muted);
    font-size: 15px;
    margin-bottom: 32px;
  }
  .education-section :global(.education-grid) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 64px;
  }
  .education-section :global(h3) {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.5;
    margin-bottom: 20px;
  }
  .education-section :global(.institution-header) {
    margin-bottom: 16px;
  }
  .education-section :global(.institution-brand) {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 18px;
    color: var(--ink);
  }
  .education-section :global(.institution-brand a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .education-section :global(.institution-brand img) {
    display: block;
    width: 19px;
    height: 24px;
  }
  .education-section :global(.institution-brand .edx-brand) {
    width: 64px;
    height: auto;
  }
  .education-section :global(.university-name) {
    font-family: var(--font-serif);
    font-size: 26px;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }
  .education-section :global(.institution-header p) {
    color: var(--muted);
    font-size: 12px;
    line-height: 20px;
    margin-top: 4px;
  }
  .education-section :global(.coursework-list),
  .education-section :global(.course-grid) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .education-section :global(.coursework-list > li + li) {
    margin-top: 28px;
  }
  .education-section :global(.datacamp-group) {
    container: coursework / inline-size;
  }
  .education-section :global(.course-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 18px 24px;
  }
  .education-section :global(.course-grid li) {
    min-width: 0;
  }
  .education-section :global(.course-grid li:last-child:nth-child(odd)) {
    grid-column: 1 / -1;
  }
  .education-section :global(.credential-entry) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-height: 54px;
    height: 100%;
    color: var(--ink);
  }
  .education-section :global(.credential-entry h4) {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .education-section :global(.credential-entry time) {
    color: var(--muted);
    font-size: 12px;
    line-height: 20px;
  }
  .education-section :global(.credential-link h4) {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .education-section :global(.credential-link:hover h4),
  .education-section :global(.credential-link:focus-visible h4) {
    color: var(--green);
    text-decoration-color: currentColor;
  }
  .education-section :global(.foundation h4) {
    color: var(--muted);
    font-size: 16px;
  }
  @container coursework (max-width: 520px) {
    .education-section :global(.course-grid) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 1100px) {
    .education-section :global(.education-grid) {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
</style>
