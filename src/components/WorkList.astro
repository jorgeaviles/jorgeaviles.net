---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
interface Props {
  entries: CollectionEntry<'work'>[];
  headingLevel?: 'h2' | 'h3';
}
const { entries, headingLevel: Heading = 'h3' } = Astro.props;
---

<div class="work-list">
  {entries.map((entry, index) => (
    <a class="work-row" href={`/work/${entry.id}/`}>
      <span class="work-number">{String(index + 1).padStart(2, '0')}</span>
      <div>
        <span class="work-category">{entry.data.category}</span>
        <Heading class="work-title">{entry.data.title}</Heading>
        <p>{entry.data.description}</p>
        {entry.data.overview && (
          <p class="work-technologies">
            {entry.data.overview.technologies.join(' · ')}
          </p>
        )}
      </div>
      <Arrow />
    </a>
  ))}
</div>
