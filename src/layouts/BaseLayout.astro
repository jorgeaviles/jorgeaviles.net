---
import '../styles/global.css';
import { site, navigation } from '../config/site';
import Arrow from '../components/Arrow.astro';
import BrandIcon from '../components/BrandIcon.astro';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — Data platforms & applications`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const active = (href: string) => Astro.url.pathname.startsWith(href);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.name,
      url: site.url,
      sameAs: [site.github, site.linkedin],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      name: site.name,
      url: site.url,
      description: site.description,
      author: { '@id': `${site.url}/#person` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f2" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/social-preview.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${site.name} — Business analysis, data engineering, applied research, application development`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
          <img
            class="monogram"
            src="/monogram.svg"
            alt=""
            width="35"
            height="42"
          />
          <span>{site.name}</span>
        </a>
        <nav aria-label="Main navigation">
          {navigation.map(({ label, href }) => (
            <a href={href} aria-current={active(href) ? 'page' : undefined}>
              {label}
            </a>
          ))}
        </nav>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <div>
          <a class="footer-name" href="/">
            {site.name}
            <span aria-hidden="true">.</span>
          </a>
          <p>Thoughtful analysis. Useful systems.</p>
        </div>
        <div class="footer-links">
          <a href={site.github}>
            <BrandIcon brand="github" /> GitHub <Arrow diagonal />
          </a>
          <a href={site.linkedin}>
            <BrandIcon brand="linkedin" /> LinkedIn <Arrow diagonal />
          </a>
          <a href="/ask/" aria-label="Ask about my work">
            Ask
          </a>
          <a href="/colophon/">Colophon</a>
        </div>
        <p class="copyright">
          © {new Date().getFullYear()} {site.name}
        </p>
      </footer>
    </div>
  </body>
</html>
